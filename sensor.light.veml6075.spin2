{
----------------------------------------------------------------------------------------------------
    Filename:       sensor.light.veml6075.spin2
    Description:    Driver for the Vishay VEML6075 UVA/UVB sensor
    Author:         Jesse Burt
    Started:        Nov 14, 2019
    Updated:        Nov 21, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    { default I/O configuration - these can be overridden by the parent object }
    SCL             = 0
    SDA             = 1
    I2C_FREQ        = 100_000


    { opmode() modes }
    CONT            = 0
    SINGLE          = 1


    SLAVE_WR        = core.SLAVE_ADDR
    SLAVE_RD        = core.SLAVE_ADDR|1


OBJ

    i2c:    "com.i2c"                           ' I2C engine
    core:   "core.con.veml6075"                 ' HW-specific constants


PUB null()
' This is not a top-level object


PUB start(): status
' Start using default I/O settings
    return startx(SCL, SDA, I2C_FREQ)


PUB startx(SCL_PIN, SDA_PIN, I2C_HZ): status
' Start using custom settings
    if ( lookdown(SCL_PIN: 0..63) and lookdown(SDA_PIN: 0..63) )
        if ( status := i2c.init(SCL_PIN, SDA_PIN, I2C_HZ) )
            waitus(core.T_POR)
            i2c.reset()                         ' attempt to make startup
            i2c.stop()                          '   more reliable
            if ( dev_id() == core.DEV_ID_RESP )
                return
    ' if this point is reached, something above failed
    ' Double check I/O pin assignments, connections, power
    ' Lastly - make sure you have at least one free core/cog
    return FALSE


PUB stop()
' Stop the driver
    powered(FALSE)
    waitms(1)
    i2c.deinit()


PUB preset_active()
' Enable sensor power, set to 100ms integration time, continuous measurements
    powered(TRUE)
    dynamic(DR_NORMAL)
    integr_time(100)
    opmode(CONT)


PUB dev_id(): id
' Device ID of the chip
'   Known values: $0026
    return readreg(core.DEV_ID)


con

    ' dynamic() settings
    DR_NORMAL    = 0
    DR_HIGH      = 1

PUB dynamic(dr=-2): c
' Set sensor dynamic range
'   Valid values: DR_NORMAL (0), DR_HIGH (1)
'   Any other value polls the chip and returns the current setting
    c := readreg(core.UV_CONF)
    case dr
        DR_NORMAL, DR_HIGH:
            dr <<= core.HD
            dr := ((c & core.HD_MASK) | dr)
            writereg(core.UV_CONF, dr)
        other:
            return ( (c >> core.HD) & 1 )


PUB integr_time(t=-2): c
' Set sensor ADC integration time, in ms
'   Valid values: 50, 100, 200, 400, 800
'   Any other value polls the chip and returns the current setting
    c := readreg(core.UV_CONF)
    case t
        50, 100, 200, 400, 800:
            t := lookdownz(t: 50, 100, 200, 400, 800) << core.UV_IT
            t := ((c & core.UV_IT_MASK) | t)
            writereg(core.UV_CONF, t)
        other:
            c := (c >> core.UV_IT) & core.UV_IT_BITS
            return lookupz(c: 50, 100, 200, 400, 800)


PUB ir_data(): d
' Read Infrared sensor data
'   Returns: 16-bit word
    return readreg(core.UVCOMP2)


PUB measure() | tmp
' Trigger a single measurement
'   NOTE: For use when opmode() is set to SINGLE
    tmp := readreg(core.UV_CONF)
    tmp.byte[0] |= (1 << core.UV_TRIG)
    tmp.byte[1] := 0
    writereg(core.UV_CONF, tmp)


PUB opmode(md=-2): c
' Set measurement mode
'   Valid values:
'       CONT (0): Continuous measurement mode
'       SINGLE (1): Single-measurement mode
'   Any other value polls the chip and returns the current setting
'   NOTE: In SINGLE mode, measurements must be triggered manually using the
'       measure() method
    c := readreg(core.UV_CONF)
    case md
        CONT, SINGLE:
            md <<= core.UV_AF
            md := ((c & core.UV_AF_MASK) | md)
            writereg(core.UV_CONF, md)
        other:
            return ( (c >> core.UV_AF) & 1 )


PUB powered(p=-2): c
' Power on sensor
'   Valid values:
'       TRUE (-1 or 1): Power on
'       FALSE (0): Power off
'   Any other value polls the chip and returns the current setting
    c := readreg(core.UV_CONF)
    case abs(p)
        0, 1:
            p := (abs(p) ^ 1) & 1               ' logic on chip is inverted,
            p := ((c & core.SD_MASK) | p)
            writereg(core.UV_CONF, p)
        other:                                  ' so flip the bit
            return ( (c & 1) == 1 )


PUB uva_data(): d
' Read UV-A sensor data
'   Returns: 16-bit word
    return readreg(core.UVA_DATA)


PUB uvb_data(): d
' Read UV-B sensor data
'   Returns: 16-bit word
    return readreg(core.UVB_DATA)


CON

    { Coefficients for calculating UV Index }
    CO_A            = 2_22
    CO_B            = 1_33
    CO_C            = 2_95
    CO_D            = 1_74
    UVA_RESP        = 0_001461
    UVB_RESP        = 0_002591

PUB uv_index(): i | uva_raw, uva_comp, uvb_raw, uvb_comp, uvcomp1, uvcomp2
' Return UV Index, in hundredths of a point (e.g. 103 == 1.03)
    uva_raw := uva_data() * 100
    uvb_raw := uvb_data() * 100
    uvcomp1 := white_data()
    uvcomp2 := ir_data()

    uva_comp := uva_raw - (CO_A * uvcomp1) - (CO_B * uvcomp2)
    uvb_comp := uvb_raw - (CO_C * uvcomp1) - (CO_D * uvcomp2)
    return (((uva_comp * UVA_RESP) + (uvb_comp * UVB_RESP)) / 2) / 1_000_000


PUB white_data(): w
' Read white/visible sensor data
'   Returns: 16-bit word
    return readreg(core.UVCOMP1)


PRI readreg(reg_nr): v | cmd_pkt
' Read nr_bytes from slave device into ptr_buff
    cmd_pkt.byte[0] := SLAVE_WR
    cmd_pkt.byte[1] := reg_nr
    v := 0
    i2c.start()
    i2c.wrblock_lsbf(@cmd_pkt, 2)
    i2c.wait(SLAVE_RD)
    i2c.rdblock_lsbf(@v, 2, i2c.NAK)
    i2c.stop()


PRI writereg(reg_nr, val) | cmd_pkt
' Write nr_bytes from ptr_buff to slave device
    case reg_nr
        core.UV_CONF:
            cmd_pkt.byte[0] := SLAVE_WR
            cmd_pkt.byte[1] := reg_nr
            cmd_pkt.byte[2] := val.byte[0]
            cmd_pkt.byte[3] := val.byte[1]
            i2c.start()
            i2c.wrblock_lsbf(@cmd_pkt, 4)
            i2c.stop()
        other:
            return


DAT
